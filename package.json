{
  "name": "daily-games",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "bootstrap": "bash scripts/cf.sh node scripts/setup.mjs",
    "dev": "wrangler dev",
    "dev:web": "vite web",
    "deploy": "pnpm run build:web && bash scripts/cf.sh wrangler deploy",
    "cf": "bash scripts/cf.sh wrangler",
    "build:web": "vite build web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "db:local": "wrangler d1 execute daily-games --local --file=migrations/0001_init.sql",
    "db:remote": "bash scripts/cf.sh wrangler d1 execute daily-games --remote --file=migrations/0001_init.sql",
    "images": "bash scripts/images.sh"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.11",
    "wrangler": "^4.165.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
