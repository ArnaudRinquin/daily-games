{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-games",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },

  "triggers": { "crons": ["*/15 * * * *"] },

  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*", "/admin/*", "/health"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-games",
      "database_id": "8e72b8d1-45b2-48f1-a33c-def4ff869460"
    }
  ],

  "vars": {
    "BOT_USERNAME": "DailyGamesScores_Bot",
    "MINIAPP_SHORT_NAME": "board",
    "TZ_NAME": "Europe/Paris",
    "CUTOFF_HOUR": "21",
    "DAY_ROLLOVER_HOUR": "4"
  },

  "env": {
    "dev": {
      "name": "daily-games-dev",
      "vars": {
        "BOT_USERNAME": "",
        "MINIAPP_SHORT_NAME": "",
        "TZ_NAME": "Europe/Paris",
        "CUTOFF_HOUR": "21",
        "DAY_ROLLOVER_HOUR": "4"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "daily-games-dev",
          "database_id": "8e72b8d1-45b2-48f1-a33c-def4ff869460"
        }
      ]
    }
  }
}
